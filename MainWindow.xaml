<Window x:Class="DMA_SPEEDTEST.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DMA_SPEEDTEST"
        mc:Ignorable="d"
        Title="DMA Control Center - USB 3.0" Height="700" Width="900"
        Background="#1E1E1E" FontFamily="Segoe UI" Foreground="White"
        WindowStartupLocation="CenterScreen">

    <!-- Ressources pour styliser les éléments en mode Sombre -->
    <Window.Resources>
        <!-- Style des Onglets -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Padding="20,10" Margin="0,0,5,0" Background="#2D2D30" CornerRadius="6,6,0,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style des TextBoxes -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Style des ComboBoxes -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>

        <!-- Style des RadioButtons pour le mode sombre -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête global de l'application -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0,0,15">
            <TextBlock Text="DMA Control Center" FontSize="26" FontWeight="Bold" Foreground="#007ACC"/>
            <TextBlock Text="{Binding DeviceStatus, FallbackValue='(Connecté via USB 3.0)'}" 
                       FontSize="14" VerticalAlignment="Bottom" Margin="15,0,0,5" Foreground="#4CAF50"/>
        </StackPanel>

        <!-- Système d'onglets principal -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- ONGLET 1 : DMA TESTS (Intègre les options de l'outil Console) -->
            <TabItem Header="DMA Tests &amp; Diagnostics" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Ligne 1 : Vitesses -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Lecture -->
                        <Border Grid.Column="0" Background="#2D2D30" CornerRadius="8" Margin="0,0,10,0" Padding="20">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="LECTURE MÉMOIRE (MAIN PC)" FontSize="14" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                    <TextBlock Text="{Binding CurrentReadSpeedMBps, FallbackValue='0.00'}" FontSize="60" FontWeight="Light" Foreground="#4CAF50"/>
                                    <TextBlock Text=" MB/s" FontSize="20" Foreground="#888888" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Écriture -->
                        <Border Grid.Column="1" Background="#2D2D30" CornerRadius="8" Margin="10,0,0,0" Padding="20">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="ÉCRITURE MÉMOIRE (MAIN PC)" FontSize="14" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                    <TextBlock Text="{Binding CurrentWriteSpeedMBps, FallbackValue='0.00'}" FontSize="60" FontWeight="Light" Foreground="#FF5252"/>
                                    <TextBlock Text=" MB/s" FontSize="20" Foreground="#888888" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Ligne 2 : Sélection du Test et Options (Inspiré de lone's DMA Test Tool) -->
                    <Border Grid.Row="1" Background="#2D2D30" CornerRadius="8" Margin="0,15,0,0" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="MODE DE TEST :" VerticalAlignment="Center" Foreground="#888888" FontWeight="SemiBold" Margin="0,0,15,0"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton Content="1. Full Test (Recommended)" IsChecked="True"/>
                                <RadioButton Content="2. Speed Test"/>
                                <RadioButton Content="3. Throughput Test"/>
                            </StackPanel>

                            <!-- Bouton Options -->
                            <Button Grid.Column="2" Content="⚙ 4. Options" Command="{Binding OpenOptionsCommand}" 
                                    Width="110" Height="28" Background="#555555" Foreground="White" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Ligne 3 : Console / Logs du Test -->
                    <Border Grid.Row="2" BorderBrush="#555555" BorderThickness="1" Background="#0C0C0C" CornerRadius="4" Margin="0,15,0,15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding TestLogs, FallbackValue='[lone-dma-test] En attente de sélection du test...'}" 
                                       Foreground="#00FF00" FontFamily="Consolas" Padding="10" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Ligne 4 : Boutons Start / Stop / Exit -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Lancer le Test" Command="{Binding StartTestCommand}" 
                                Width="140" Height="40" Background="#007ACC" Foreground="White" 
                                FontSize="14" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Stop" Command="{Binding StopTestCommand}" 
                                Width="90" Height="40" Background="#555555" Foreground="White" 
                                FontSize="14" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Bouton Exit -->
                        <Button Content="5. Exit" Command="{Binding ExitCommand}" 
                                Width="90" Height="40" Background="#D32F2F" Foreground="White" 
                                FontSize="14" FontWeight="Bold" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ONGLET 2 : FIRMWARE FLASHER (Reproduction CH347) -->
            <TabItem Header="Flasher Firmware" FontSize="14" FontWeight="SemiBold">
                <Border Background="#2D2D30" CornerRadius="8" Margin="0,20,0,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Ligne 1 : Configuration -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Modèle FPGA :" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" Width="140" SelectedIndex="0">
                                <ComboBoxItem Content="xc7k325t"/>
                                <ComboBoxItem Content="xc7a12t"/>
                                <ComboBoxItem Content="xc7a15t"/>
                                <ComboBoxItem Content="xc7a35t"/>
                                <ComboBoxItem Content="xc7k160t"/>
                                <ComboBoxItem Content="xc6slx100"/>
                                <ComboBoxItem Content="xc6slx150"/>
                                <ComboBoxItem Content="xc6slx25"/>
                            </ComboBox>

                            <TextBlock Grid.Column="2" Text="Type de fichier :" VerticalAlignment="Center" Margin="25,0,10,0"/>
                            <ComboBox Grid.Column="3" Width="70" SelectedIndex="0">
                                <ComboBoxItem Content="BIT"/>
                                <ComboBoxItem Content="BIN"/>
                            </ComboBox>

                            <TextBlock Grid.Column="4" Text="Horloge matérielle :" VerticalAlignment="Center" Margin="25,0,10,0"/>
                            <ComboBox Grid.Column="5" Width="100" SelectedIndex="0">
                                <ComboBoxItem Content="10000000"/>
                            </ComboBox>
                            <TextBlock Grid.Column="6" Text="Hz" VerticalAlignment="Center" Margin="10,0,0,0"/>

                            <Button Grid.Column="8" Content="À propos" Width="80" Height="26" Background="#555555" Foreground="White" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- Ligne 2 : Sélection du fichier -->
                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Choisir le fichier..." Command="{Binding BrowseFirmwareCommand}" 
                                    Width="130" Height="28" Background="#555555" Foreground="White" BorderThickness="0" Margin="0,0,15,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <TextBox Grid.Column="1" Text="{Binding FirmwareFilePath}" Height="28" IsReadOnly="True" />
                        </Grid>

                        <!-- Ligne 3 : Bouton de téléchargement / Flash -->
                        <Button Grid.Row="2" Content="FLASHER LE FIRMWARE" Command="{Binding FlashFirmwareCommand}" 
                                Height="35" Background="#D32F2F" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Margin="0,0,0,15">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Ligne 4 : Informations sur le périphérique et bouton effacer -->
                        <Grid Grid.Row="3" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Infos Périphérique" Width="130" Height="28" Background="#555555" Foreground="White" BorderThickness="0" Margin="0,0,15,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <TextBox Grid.Column="1" Text="Aucun périphérique connecté" Height="28" IsReadOnly="True" Margin="0,0,15,0" Foreground="#AAAAAA"/>
                            <Button Grid.Column="2" Content="Effacer console" Width="110" Height="28" Background="#555555" Foreground="White" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- Ligne 5 : Console / Logs -->
                        <Border Grid.Row="4" BorderBrush="#555555" BorderThickness="1" Background="#0C0C0C" CornerRadius="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="[System] Prêt à flasher. En attente de la carte DMA..." 
                                           Foreground="#00FF00" FontFamily="Consolas" Padding="10" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</Window>