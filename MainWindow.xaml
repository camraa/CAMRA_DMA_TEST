<Window x:Class="DMA_SPEEDTEST.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DMA_SPEEDTEST.ViewModels"
        Title="Utilitaire DMA - Configuration &amp; Diagnostics" Height="800" Width="1050"
        Background="#121212" FontFamily="Segoe UI" Foreground="White"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Padding="20,10" Margin="0,0,5,0" Background="Transparent" BorderBrush="#333333" BorderThickness="0,0,0,3">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#E5C07B"/>
                                <Setter Property="Foreground" Value="#E5C07B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding CurrentStep}">

            <TabItem Header="1. Langue" FontSize="15" FontWeight="Bold">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Sélection de la langue" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Choisissez votre langue pour continuer" Foreground="#AAAAAA" FontSize="16" Margin="0,0,0,30"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Français" Width="140" Height="50" Background="#E5C07B" Foreground="Black" FontWeight="Bold" Margin="10" BorderThickness="0"/>
                        <Button Content="English" Width="140" Height="50" Background="#2D2D30" Foreground="White" FontWeight="Bold" Margin="10" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="2. Sécurité" FontSize="15" FontWeight="Bold">
                <StackPanel Margin="40,30">
                    <TextBlock Text="⚠ Avertissement de sécurité important" FontSize="24" FontWeight="Bold" Foreground="#E5C07B" Margin="0,0,0,10"/>
                    <Border Background="#3D1515" BorderBrush="#FF5252" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,25">
                        <TextBlock Text="CETTE APPLICATION DOIT ÊTRE INSTALLÉE SUR VOTRE SECOND PC (RADAR) UNIQUEMENT.&#x0a;N'installez et n'exécutez jamais ces outils sur votre PC de jeu (Host)." 
                                   Foreground="#FF8888" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="Étapes d'installation physique :" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="1. Éteignez le 1er PC (PC de jeu).&#x0a;2. Débranchez l'alimentation électrique.&#x0a;3. Installez la carte DMA dans le port PCIe du PC de jeu.&#x0a;4. IMPORTANT : Au premier démarrage, allez directement dans le BIOS. Cela empêche Windows d'enregistrer le firmware d'usine (qui peut déclencher un ban)." 
                               Foreground="#CCCCCC" FontSize="15" LineHeight="28" TextWrapping="Wrap" Margin="0,0,0,35"/>
                    <CheckBox Content="Je confirme que je suis actuellement sur mon SECOND PC (Radar)" IsChecked="{Binding IsSecondPcConfirmed}" 
                              Foreground="White" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="3. Matériel" FontSize="15" FontWeight="Bold">
                <StackPanel Margin="40,30">
                    <TextBlock Text="Sélection du Matériel" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Sélectionnez le modèle de la carte DMA que vous utilisez" Foreground="#AAAAAA" FontSize="15" Margin="0,0,0,30"/>
                    <TextBlock Text="Modèle de la puce FPGA" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Version 75T" Foreground="White" Margin="0,0,30,0" IsChecked="True"/>
                        <RadioButton Content="Version 100T" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="4. Diagnostics &amp; Outils" FontSize="15" FontWeight="Bold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
                    <StackPanel Margin="30,20">
                        <TextBlock Text="Tableau de bord : Diagnostics &amp; Utilitaires" FontSize="26" FontWeight="Bold" Margin="0,0,0,25" Foreground="#E5C07B"/>

                        <!-- SECTION A : DIAGNOSTICS SYSTÈME -->
                        <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,25">
                            <StackPanel>
                                <TextBlock Text="ÉTAT DU SYSTÈME" FontSize="16" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,15"/>
                                <Border Background="#2D2D30" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding LaptopStatus}" Foreground="{Binding LaptopColor}" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#2D2D30" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding DefenderStatus}" Foreground="{Binding DefenderColor}" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#2D2D30" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding CH347Status}" Foreground="{Binding CH347Color}" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#2D2D30" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding FTDIStatus}" Foreground="{Binding FTDIColor}" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#2D2D30" CornerRadius="4" Padding="12" Margin="0,0,0,15">
                                    <TextBlock Text="{Binding RuntimesStatus}" Foreground="{Binding RuntimesColor}" FontWeight="SemiBold"/>
                                </Border>
                                <Button Content="Relancer l'analyse du système" Command="{Binding RunDiagnosticsCommand}" 
                                        Width="220" Height="35" Background="#555555" Foreground="White" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- SECTION B : SPEED TEST COMPLET -->
                        <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,25">
                            <StackPanel>
                                <TextBlock Text="TEST DE VITESSE DMA (VIA PORT DATA/FTDI)" FontSize="16" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,15"/>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#2D2D30" CornerRadius="6" Margin="0,0,10,0" Padding="15">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="LECTURE (READ)" Foreground="#888888" HorizontalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding CurrentReadSpeedMBps}" FontSize="45" FontWeight="Light" Foreground="#4CAF50"/>
                                                <TextBlock Text=" MB/s" FontSize="16" Foreground="#888888" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#2D2D30" CornerRadius="6" Margin="10,0,0,0" Padding="15">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="ÉCRITURE (WRITE)" Foreground="#888888" HorizontalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding CurrentWriteSpeedMBps}" FontSize="45" FontWeight="Light" Foreground="#FF5252"/>
                                                <TextBlock Text=" MB/s" FontSize="16" Foreground="#888888" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <RadioButton Content="Full Test" IsChecked="True"/>
                                    <RadioButton Content="Speed Test"/>
                                    <RadioButton Content="Throughput Test"/>
                                </StackPanel>

                                <Border BorderBrush="#555555" BorderThickness="1" Background="#0C0C0C" CornerRadius="4" Margin="0,0,0,15" Height="80">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding TestLogs}" Foreground="#00FF00" FontFamily="Consolas" Padding="10" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Démarrer le Test" Command="{Binding StartTestCommand}" Width="150" Height="35" Background="#007ACC" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                                    <Button Content="Arrêter" Command="{Binding StopTestCommand}" Width="90" Height="35" Background="#555555" Foreground="White"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- SECTION C : FLASHEUR DE FIRMWARE -->
                        <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="FLASHEUR DE FIRMWARE (VIA PORT JTAG/CH347)" FontSize="16" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,15"/>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="FPGA :" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox Grid.Column="1" Width="140" SelectedIndex="0">
                                        <ComboBoxItem Content="xc7k325t"/>
                                        <ComboBoxItem Content="xc3s100e"/>
                                        <ComboBoxItem Content="xc3s1200e"/>
                                        <ComboBoxItem Content="xc3s1400a"/>
                                        <ComboBoxItem Content="xc3s1400an"/>
                                        <ComboBoxItem Content="xc3s1600e"/>
                                        <ComboBoxItem Content="xc3s200a"/>
                                        <ComboBoxItem Content="xc3s200an"/>
                                        <ComboBoxItem Content="xc3s250e"/>
                                        <ComboBoxItem Content="xc3s400a"/>
                                        <ComboBoxItem Content="xc3s400an"/>
                                        <ComboBoxItem Content="xc3s500e"/>
                                        <ComboBoxItem Content="xc3s50a"/>
                                        <ComboBoxItem Content="xc3s50an"/>
                                        <ComboBoxItem Content="xc3s700a"/>
                                        <ComboBoxItem Content="xc3s700an"/>
                                        <ComboBoxItem Content="xc3sd1800a"/>
                                        <ComboBoxItem Content="xc3sd3400a"/>
                                        <ComboBoxItem Content="xc6slx100"/>
                                        <ComboBoxItem Content="xc6slx100t"/>
                                        <ComboBoxItem Content="xc6slx150"/>
                                        <ComboBoxItem Content="xc6slx150t"/>
                                        <ComboBoxItem Content="xc6slx16"/>
                                        <ComboBoxItem Content="xc6slx25"/>
                                        <ComboBoxItem Content="xc6slx25t"/>
                                        <ComboBoxItem Content="xc6slx4"/>
                                        <ComboBoxItem Content="xc6slx45"/>
                                        <ComboBoxItem Content="xc6slx45t"/>
                                        <ComboBoxItem Content="xc6slx75"/>
                                        <ComboBoxItem Content="xc6slx75t"/>
                                        <ComboBoxItem Content="xc6slx9"/>
                                        <ComboBoxItem Content="xc7a100t"/>
                                        <ComboBoxItem Content="xc7a12t"/>
                                        <ComboBoxItem Content="xc7a15t"/>
                                        <ComboBoxItem Content="xc7a200t"/>
                                        <ComboBoxItem Content="xc7a25t"/>
                                        <ComboBoxItem Content="xc7a35t"/>
                                        <ComboBoxItem Content="xc7a50t"/>
                                        <ComboBoxItem Content="xc7a75t"/>
                                        <ComboBoxItem Content="xc7k160t"/>
                                        <ComboBoxItem Content="xc7k3...debug"/>
                                        <ComboBoxItem Content="xc7k355t"/>
                                        <ComboBoxItem Content="xc7k410t"/>
                                        <ComboBoxItem Content="xc7k420t"/>
                                        <ComboBoxItem Content="xc7k480t"/>
                                        <ComboBoxItem Content="xc7k70t"/>
                                        <ComboBoxItem Content="xc7s25"/>
                                        <ComboBoxItem Content="xc7s50"/>
                                        <ComboBoxItem Content="xc7v2000t"/>
                                        <ComboBoxItem Content="xc7v585t"/>
                                        <ComboBoxItem Content="xc7vh580t"/>
                                        <ComboBoxItem Content="xc7vh870t"/>
                                        <ComboBoxItem Content="xc7vx1140t"/>
                                        <ComboBoxItem Content="xc7vx330t"/>
                                        <ComboBoxItem Content="xc7vx415t"/>
                                        <ComboBoxItem Content="xc7vx485t"/>
                                        <ComboBoxItem Content="xc7vx550t"/>
                                        <ComboBoxItem Content="xc7vx690t"/>
                                        <ComboBoxItem Content="xc7vx980t"/>
                                        <ComboBoxItem Content="xcku040"/>
                                    </ComboBox>
                                    <TextBlock Grid.Column="2" Text="Format :" VerticalAlignment="Center" Margin="20,0,10,0"/>
                                    <ComboBox Grid.Column="3" Width="60" SelectedIndex="0">
                                        <ComboBoxItem Content="BIN"/>
                                        <ComboBoxItem Content="BIT"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Choisir le firmware..." Command="{Binding BrowseFirmwareCommand}" Width="150" Height="32" Background="#555555" Foreground="White" Margin="0,0,15,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding FirmwareFilePath}" Height="32" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                </Grid>

                                <Border BorderBrush="#555555" BorderThickness="1" Background="#0C0C0C" CornerRadius="4" Margin="0,0,0,15" Height="80">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding FlashLogs}" Foreground="#00FF00" FontFamily="Consolas" Padding="10" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Flasher la carte" Command="{Binding FlashFirmwareCommand}" Width="160" Height="35" Background="#D32F2F" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                                    <Button Content="Lire l'ADN (DNA)" Command="{Binding RetrieveDnaCommand}" Width="140" Height="35" Background="#E5C07B" Foreground="Black" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Boutons de navigation globale (Précédent / Suivant) -->
        <Border Grid.Row="2" Background="#1A1A1A" Padding="15">
            <Grid>
                <Button Content="Précédent" Command="{Binding BackCommand}" Width="110" Height="35" Background="#333333" Foreground="White" HorizontalAlignment="Left" FontSize="14"/>
                <Button Content="Suivant" Command="{Binding NextCommand}" Width="110" Height="35" Background="#E5C07B" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Right" FontSize="14"/>
            </Grid>
        </Border>
    </Grid>
</Window>